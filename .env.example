# Copy to .env and adjust. Every setting can also be an environment variable.

# --- the brain: any OpenAI-compatible endpoint ----------------------------------------------------------------
# Ollama:     http://127.0.0.1:11434/v1        LM Studio: http://127.0.0.1:1234/v1
# llama.cpp:  http://127.0.0.1:8080/v1         vLLM:      http://127.0.0.1:8000/v1
# OpenAI:     https://api.openai.com/v1        OpenRouter: https://openrouter.ai/api/v1
FV_LLM_URL=http://127.0.0.1:11434/v1
FV_LLM_KEY=
FV_LLM_MODEL=
# extra request fields as JSON, e.g. {"temperature": 0.7} or for Qwen3 thinking models {"chat_template_kwargs": {"enable_thinking": false}}
FV_LLM_EXTRA=
# empty = a built-in prompt for short, spoken answers ({date} is replaced by today's date)
FV_SYSTEM_PROMPT=

# --- the services ----------------------------------------------------------------------------------------------
FV_TTS_URL=http://127.0.0.1:8086
FV_STT_URL=http://127.0.0.1:8087
# Clef (llama-server with clef-flash); empty = simple rules instead (works, a bit less clever)
FV_CLEF_URL=http://127.0.0.1:8088
FV_LANGS=en,de
FV_VOICE=serena

# --- the page --------------------------------------------------------------------------------------------------
# 127.0.0.1 = this computer only. 0.0.0.0 = other devices too: then set a password and use https
FV_HOST=127.0.0.1
FV_PORT=8099
FV_PASSWORD=
# https: paths to a certificate and key, or "self" for a self-signed one (the phone warns once)
FV_CERT=
FV_KEY=
